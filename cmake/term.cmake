# Affichage terminal : couleurs ANSI, cadres et barres, partagés par la bannière du configure
# (cmake/banner.cmake) et le rapport de fin de build (cmake/build_report.cmake).
#
# NO_COLOR=1        désactive les couleurs (convention https://no-color.org)
# LOGOLITH_ASCII=1  dessine en ASCII pur, pour un terminal qui n'affiche pas l'UTF-8

# term_init(<toujours en couleur>) : prépare les codes couleur C_* et les glyphes G_*.
# Au configure, la couleur n'est activée que si l'on est dans un vrai terminal. Pendant le build,
# Ninja retire lui-même les couleurs quand sa sortie n'est pas un terminal.
macro(term_init always_color)
    string(ASCII 27 TERM_ESC)

    set(_term_color OFF)
    if(${always_color} OR DEFINED ENV{CLICOLOR_FORCE} OR DEFINED ENV{WT_SESSION}
       OR DEFINED ENV{TERM_PROGRAM} OR DEFINED ENV{GITHUB_ACTIONS})
        set(_term_color ON)
    endif()
    if(DEFINED ENV{NO_COLOR})
        set(_term_color OFF)
    endif()

    # Couleurs 256 teintes, rendues par Windows Terminal, VS Code et les logs GitHub Actions.
    set(C_RESET "")
    set(C_BOLD "")
    set(C_DIM "")
    set(C_GREEN "")
    set(C_YELLOW "")
    set(C_RED "")
    set(C_CYAN "")
    set(C_BLUE "")
    set(C_VIOLET "")
    set(C_GREY "")
    if(_term_color)
        set(C_RESET "${TERM_ESC}[0m")
        set(C_BOLD "${TERM_ESC}[1m")
        set(C_DIM "${TERM_ESC}[2m")
        set(C_GREEN "${TERM_ESC}[38;5;78m")
        set(C_YELLOW "${TERM_ESC}[38;5;221m")
        set(C_RED "${TERM_ESC}[38;5;203m")
        set(C_CYAN "${TERM_ESC}[38;5;80m")
        set(C_BLUE "${TERM_ESC}[38;5;75m")
        set(C_VIOLET "${TERM_ESC}[38;5;141m")
        set(C_GREY "${TERM_ESC}[38;5;244m")
    endif()

    if("$ENV{LOGOLITH_ASCII}")
        set(G_TL "+")
        set(G_TR "+")
        set(G_BL "+")
        set(G_BR "+")
        set(G_H "-")
        set(G_V "|")
        set(G_OK "*")
        set(G_KO "x")
        set(G_ARROW ">")
        set(G_DOT "-")
        set(G_FULL "#")
        set(G_EMPTY ".")
        set(G_PARTS "")
    else()
        set(G_TL "╭")
        set(G_TR "╮")
        set(G_BL "╰")
        set(G_BR "╯")
        set(G_H "─")
        set(G_V "│")
        set(G_OK "✔")
        set(G_KO "✘")
        set(G_ARROW "▶")
        set(G_DOT "·")
        set(G_FULL "█")
        set(G_EMPTY "░")
        set(G_PARTS "▏;▎;▍;▌;▋;▊;▉") # huitièmes de case, pour une barre précise
    endif()
endmacro()

# Largeur affichée d'un texte : sans les codes couleur, chaque caractère accentué ou glyphe compte 1.
function(term_width out text)
    string(REGEX REPLACE "${TERM_ESC}\\[[0-9;]*m" "" t "${text}")
    foreach(g ╭ ╮ ╰ ╯ ─ │ ✔ ✘ ━ ▶ · █ ░ ▏ ▎ ▍ ▌ ▋ ▊ ▉ é è ê à â ç ô û î É)
        string(REPLACE "${g}" "x" t "${t}")
    endforeach()
    string(LENGTH "${t}" n)
    set(${out} ${n} PARENT_SCOPE)
endfunction()

# Complète un texte par des espaces (à droite) ou le cale à droite (RIGHT) sur une largeur donnée.
function(term_pad out text width)
    term_width(n "${text}")
    math(EXPR missing "${width} - ${n}")
    set(fill "")
    if(missing GREATER 0)
        string(REPEAT " " ${missing} fill)
    endif()
    if(ARGV3 STREQUAL "RIGHT")
        set(${out} "${fill}${text}" PARENT_SCOPE)
    else()
        set(${out} "${text}${fill}" PARENT_SCOPE)
    endif()
endfunction()

function(term_repeat out glyph count)
    set(s "")
    if(count GREATER 0)
        string(REPEAT "${glyph}" ${count} s)
    endif()
    set(${out} "${s}" PARENT_SCOPE)
endfunction()

# Ligne de cadre : haut avec titre éventuel, ou bas.
function(term_box_top out width title)
    if(title STREQUAL "")
        math(EXPR n "${width} - 2")
        term_repeat(h "${G_H}" ${n})
        set(${out} "${C_GREY}${G_TL}${h}${G_TR}${C_RESET}" PARENT_SCOPE)
    else()
        term_width(tw "${title}")
        math(EXPR n "${width} - ${tw} - 5")
        term_repeat(h "${G_H}" ${n})
        set(${out} "${C_GREY}${G_TL}${G_H} ${C_RESET}${title}${C_GREY} ${h}${G_TR}${C_RESET}" PARENT_SCOPE)
    endif()
endfunction()

function(term_box_bottom out width)
    math(EXPR n "${width} - 2")
    term_repeat(h "${G_H}" ${n})
    set(${out} "${C_GREY}${G_BL}${h}${G_BR}${C_RESET}" PARENT_SCOPE)
endfunction()

# Ligne de contenu encadrée, complétée jusqu'à la largeur du cadre.
function(term_box_line out width content)
    math(EXPR inner "${width} - 4")
    term_pad(c "${content}" ${inner})
    set(${out} "${C_GREY}${G_V}${C_RESET} ${c} ${C_GREY}${G_V}${C_RESET}" PARENT_SCOPE)
endfunction()

# Barre de remplissage, colorée selon le taux : vert, jaune au-delà de 70 %, rouge au-delà de 90 %.
function(term_bar out used total width)
    if(total LESS_EQUAL 0)
        set(total 1)
    endif()
    math(EXPR eighths "${used} * ${width} * 8 / ${total}")
    if(used GREATER 0 AND eighths EQUAL 0)
        set(eighths 1) # une occupation non nulle reste visible
    endif()
    math(EXPR max "${width} * 8")
    if(eighths GREATER max)
        set(eighths ${max})
    endif()

    list(LENGTH G_PARTS nparts)
    if(nparts EQUAL 0)
        math(EXPR full "(${eighths} + 4) / 8")
        set(part "")
        set(part_w 0)
    else()
        math(EXPR full "${eighths} / 8")
        math(EXPR rem "${eighths} % 8")
        set(part "")
        set(part_w 0)
        if(rem GREATER 0)
            math(EXPR idx "${rem} - 1")
            list(GET G_PARTS ${idx} part)
            set(part_w 1)
        endif()
    endif()
    math(EXPR empty "${width} - ${full} - ${part_w}")

    math(EXPR permille "${used} * 1000 / ${total}")
    if(permille GREATER_EQUAL 900)
        set(color "${C_RED}")
    elseif(permille GREATER_EQUAL 700)
        set(color "${C_YELLOW}")
    else()
        set(color "${C_GREEN}")
    endif()

    term_repeat(f "${G_FULL}" ${full})
    term_repeat(e "${G_EMPTY}" ${empty})
    set(${out} "${color}${f}${part}${C_GREY}${e}${C_RESET}" PARENT_SCOPE)
endfunction()

# Nombre décimal à une décimale, virgule française : 45 dixièmes -> "4,5". Sans ",0" si NOZERO.
function(term_decimal out tenths)
    math(EXPR i "${tenths} / 10")
    math(EXPR d "${tenths} % 10")
    if(d EQUAL 0 AND ARGV2 STREQUAL "NOZERO")
        set(${out} "${i}" PARENT_SCOPE)
    else()
        set(${out} "${i},${d}" PARENT_SCOPE)
    endif()
endfunction()

# Taille lisible : 512 o, 4,5 Ko, 1 Mo.
function(term_size out bytes)
    if(bytes LESS 1024)
        set(${out} "${bytes} o" PARENT_SCOPE)
    elseif(bytes LESS 1048576)
        math(EXPR t "${bytes} * 10 / 1024")
        term_decimal(v ${t} NOZERO)
        set(${out} "${v} Ko" PARENT_SCOPE)
    else()
        math(EXPR t "${bytes} * 10 / 1048576")
        term_decimal(v ${t} NOZERO)
        set(${out} "${v} Mo" PARENT_SCOPE)
    endif()
endfunction()

function(term_percent out used total)
    math(EXPR permille "${used} * 1000 / ${total}")
    term_decimal(v ${permille})
    set(${out} "${v} %" PARENT_SCOPE)
endfunction()

# Affiche un texte. En mode ASCII, retire aussi les accents, illisibles dans un terminal sans UTF-8.
function(term_print text)
    if("$ENV{LOGOLITH_ASCII}")
        foreach(pair é:e è:e ê:e à:a â:a ç:c ô:o û:u î:i É:E)
            string(REPLACE ":" ";" pair "${pair}")
            list(GET pair 0 from)
            list(GET pair 1 to)
            string(REPLACE "${from}" "${to}" text "${text}")
        endforeach()
    endif()
    message(NOTICE "${text}")
endfunction()
